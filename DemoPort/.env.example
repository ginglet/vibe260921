# 이 파일을 .env 로 복사해서 사용하세요. (.env 는 저장소에 올리지 않습니다)

# 개발: True / 운영: False
DJANGO_DEBUG=True
# 운영 환경에서는 반드시 설정: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 운영 도메인 (https 포함), 쉼표로 여러 개 가능
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000

# 관리자 주소를 추측하기 어렵게 바꾸세요 (예: manage-x7k2/)
ADMIN_URL=admin/

# 운영 DB (비워 두면 SQLite 사용). 예: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# 문의 접수 알림 메일 (개발 환경은 콘솔에 출력됩니다)
CONTACT_NOTIFY_EMAIL=ginglet88@naver.com
DEFAULT_FROM_EMAIL=DemoPort <noreply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# 스팸 방지: 기준 시간(분) 동안 IP당 허용 문의 수
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MIN=60

# 영구 디스크가 있는 호스팅에서 업로드 이미지를 Django가 직접 서비스할 때 True
SERVE_MEDIA=False
